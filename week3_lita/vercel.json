{
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/index?route=/health"
    },
    {
      "source": "/swagger",
      "destination": "/api/index?route=/swagger"
    },
    {
      "source": "/openapi.yaml",
      "destination": "/api/index?route=/openapi.yaml"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index?route=/api/$1"
    }
  ]
}